<% provide(:title, "Sign In") %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="smb-card p-4 p-md-5 mb-4">
        <div class="text-center mb-4">
          <div class="mb-2 d-inline-block"><%= render "shared/brand_logo", size: 38 %></div>
          <h1 class="h3 mb-1">Sign in to ShareMyBag Exchange</h1>
          <p class="text-muted small mb-0">Access your verified flight PNRs, live order books, and airline voucher balance.</p>
        </div>

        <%= form_with scope: :session, url: sessions_path, local: true do |f| %>
          <div class="mb-3">
            <%= f.label :email, class: "form-label" do %>
              Email address <span class="smb-required" aria-hidden="true">*</span>
            <% end %>
            <%= f.email_field :email,
                class: "form-control",
                required: true,
                "aria-required": "true",
                autocomplete: "email",
                placeholder: "you@example.com" %>
          </div>

          <div class="mb-4">
            <%= f.label :password, class: "form-label" do %>
              Password <span class="smb-required" aria-hidden="true">*</span>
            <% end %>
            <%= f.password_field :password,
                class: "form-control",
                required: true,
                "aria-required": "true",
                autocomplete: "current-password" %>
          </div>

          <%= f.submit "Sign in", class: "btn btn-primary w-100 py-2" %>
        <% end %>

        <div class="text-center mt-4 small text-muted">
          New passenger? <%= link_to "Create an account", signup_path, class: "fw-semibold" %>
        </div>
      </div>

      <!-- Pre-seeded B2B Demo Accounts -->
      <section class="smb-card p-4 bg-white" aria-labelledby="demo-accounts-heading">
        <h2 id="demo-accounts-heading" class="h6 mb-2">
          <i class="fas fa-key me-2 text-primary" aria-hidden="true"></i>Instant B2B Demo Accounts (Pre-booked on Live Flights)
        </h2>
        <p class="small text-muted mb-3">
          Use these seeded accounts to test a live Bid/Ask match on <strong>AF718 (CDG → DKR)</strong> and watch PNR allowances &amp; airline net margin update immediately:
        </p>
        <div class="table-responsive">
          <table class="table table-sm mb-0 small">
            <caption class="visually-hidden">Pre-configured demo credentials for testing</caption>
            <thead>
              <tr>
                <th scope="col">Persona</th>
                <th scope="col">Email</th>
                <th scope="col">Password</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Light Traveler (Seller)</strong></td>
                <td><code>marie@example.com</code></td>
                <td><code>Marie123!</code></td>
              </tr>
              <tr>
                <td><strong>Heavy Traveler (Buyer)</strong></td>
                <td><code>pierre@example.com</code></td>
                <td><code>Pierre123!</code></td>
              </tr>
              <tr>
                <td><strong>Airline Revenue VP</strong></td>
                <td><code>vp@airfrance-demo.com</code></td>
                <td><code>Airline123!</code></td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</div>