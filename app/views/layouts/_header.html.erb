<header role="banner">
  <nav class="navbar navbar-expand-lg smb-navbar sticky-top" aria-label="Main navigation">
    <div class="container">
      <%= link_to root_path, class: "navbar-brand", aria: { label: "ShareMyBag — Home" } do %>
        <%= render "shared/brand_logo", size: 36 %>
      <% end %>

      <button class="navbar-toggler border" type="button" data-bs-toggle="collapse" data-bs-target="#smbMainNav"
              aria-controls="smbMainNav" aria-expanded="false" aria-label="Toggle navigation menu">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="smbMainNav">
        <ul class="navbar-nav me-auto ms-lg-3 gap-1">
          <% requests_active = (controller_name == 'shipping_requests' && action_name == 'index') %>
          <li class="nav-item">
            <%= link_to "Shipping requests", shipping_requests_path,
                class: "nav-link #{'active' if requests_active}",
                aria: (requests_active ? { current: "page" } : {}) %>
          </li>

          <% how_active = current_page?(how_it_works_path) %>
          <li class="nav-item">
            <%= link_to "How it works", how_it_works_path,
                class: "nav-link #{'active' if how_active}",
                aria: (how_active ? { current: "page" } : {}) %>
          </li>

          <% if signed_in? %>
            <li class="nav-item dropdown">
              <button class="nav-link dropdown-toggle btn btn-link border-0 #{'active' if action_name.in?(%w[my_requests my_bids])}"
                      type="button" id="activityMenu" data-bs-toggle="dropdown" aria-expanded="false">
                My activity
              </button>
              <ul class="dropdown-menu shadow-sm border" aria-labelledby="activityMenu">
                <li>
                  <%= link_to my_requests_shipping_requests_path, class: "dropdown-item py-2" do %>
                    <i class="fas fa-box me-2 text-primary" aria-hidden="true"></i>My shipping requests
                  <% end %>
                </li>
                <li>
                  <%= link_to my_bids_bids_path, class: "dropdown-item py-2" do %>
                    <i class="fas fa-gavel me-2 text-success" aria-hidden="true"></i>My offers
                  <% end %>
                </li>
              </ul>
            </li>

            <% msgs_active = (controller_name == 'conversations') %>
            <li class="nav-item">
              <%= link_to conversations_path,
                  class: "nav-link d-inline-flex align-items-center gap-1 #{'active' if msgs_active}",
                  aria: (msgs_active ? { current: "page" } : {}) do %>
                <span>Messages</span>
                <% unread_msgs = current_user.unread_messages_count %>
                <% if unread_msgs > 0 %>
                  <span class="badge rounded-pill text-bg-primary smb-notif-dot">
                    <%= unread_msgs > 9 ? "9+" : unread_msgs %>
                    <span class="visually-hidden">unread messages</span>
                  </span>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>

        <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
          <% if signed_in? %>
            <%= link_to new_shipping_request_path, class: "btn btn-primary btn-sm px-3" do %>
              <i class="fas fa-plus me-1" aria-hidden="true"></i>Post a parcel
            <% end %>

            <% unread_notifs = current_user.unread_notifications_count %>
            <%= link_to notifications_path,
                class: "btn btn-light btn-sm position-relative border",
                aria: { label: unread_notifs > 0 ? "Notifications (#{unread_notifs} unread)" : "Notifications" } do %>
              <i class="far fa-bell" aria-hidden="true"></i>
              <% if unread_notifs > 0 %>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-bg-danger smb-notif-dot" aria-hidden="true">
                  <%= unread_notifs > 9 ? "9+" : unread_notifs %>
                </span>
              <% end %>
            <% end %>

            <div class="dropdown">
              <button class="btn btn-light btn-sm border d-inline-flex align-items-center gap-2 dropdown-toggle"
                      type="button" id="accountMenu" data-bs-toggle="dropdown" aria-expanded="false"
                      aria-label="Account menu for <%= current_user.name %>">
                <%= user_avatar(current_user, size: :sm) %>
                <span class="d-none d-xl-inline fw-semibold"><%= current_user.name.split.first %></span>
              </button>
              <ul class="dropdown-menu dropdown-menu-end shadow-sm border" aria-labelledby="accountMenu">
                <li class="px-3 py-2">
                  <div class="fw-bold text-dark"><%= current_user.name %></div>
                  <div class="small text-muted">
                    <i class="fas fa-star smb-star-filled me-1" aria-hidden="true"></i>
                    <%= current_user.reviews_count > 0 ? "#{current_user.average_rating}/5 (#{current_user.reviews_count})" : "New member" %>
                  </div>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <%= link_to user_path(current_user), class: "dropdown-item py-2" do %>
                    <i class="far fa-user me-2" aria-hidden="true"></i>My profile
                  <% end %>
                </li>
                <li>
                  <%= link_to edit_user_path(current_user), class: "dropdown-item py-2" do %>
                    <i class="fas fa-sliders-h me-2" aria-hidden="true"></i>Profile settings
                  <% end %>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <%= button_to signout_path, method: :delete, class: "dropdown-item py-2 text-danger", form_class: "m-0" do %>
                    <i class="fas fa-sign-out-alt me-2" aria-hidden="true"></i>Sign out
                  <% end %>
                </li>
              </ul>
            </div>
          <% else %>
            <%= link_to "Sign in", signin_path, class: "btn btn-outline-secondary btn-sm px-3" %>
            <%= link_to "Post a parcel", new_shipping_request_path, class: "btn btn-primary btn-sm px-3" %>
          <% end %>
        </div>
      </div>
    </div>
  </nav>
</header>