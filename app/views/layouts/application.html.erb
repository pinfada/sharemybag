<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : 'ShareMyBag Airline Exchange: white-label flight-level Bid/Ask marketplace for digital baggage weight allowance between passengers on the same flight.' %>">
  <title><%= full_title(yield(:title)) %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", media: "all" %>
  <%= javascript_include_tag "application", defer: true %>
</head>
<body>
  <a href="#main-content" class="smb-skip-link">Skip to main content</a>

  <%= render "layouts/header" %>

  <div class="smb-demo-disclaimer" role="note" data-demo-disclaimer-banner>
    <div class="container d-flex flex-wrap align-items-center justify-content-between gap-1">
      <span>
        <strong>Demo data — Fictional airline partnerships:</strong> flight order books, airline names, and DCS sync references shown here run in an isolated sandbox (no live carrier connection).
      </span>
    </div>
  </div>

  <main id="main-content" class="smb-main" tabindex="-1">
    <% if flash.any? %>
      <div class="container pt-3">
        <% flash.each do |key, value| %>
          <% role = flash_aria_role(key) %>
          <div class="alert alert-<%= flash_bootstrap_class(key) %> alert-dismissible fade show shadow-sm mb-2"
               role="<%= role %>"
               aria-live="<%= role == 'alert' ? 'assertive' : 'polite' %>">
            <%= value %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close notification"></button>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= yield %>
  </main>

  <%= render "layouts/footer" %>
</body>
</html>
