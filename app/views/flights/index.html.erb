<% provide(:title, "Live Flight Exchanges") %>

<div class="container py-4">
  <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
    <div>
      <span class="smb-b2b-pill mb-2">
        <i class="fas fa-broadcast-tower" aria-hidden="true"></i>
        <span>Live Commercial Departure Order Books (T-48h to T-4h)</span>
      </span>
      <h1 class="h2 mb-1">Live Flight Exchanges</h1>
      <p class="text-muted mb-0">
        Inspect real-time Bid/Ask baggage allowance markets, aircraft payload envelopes, and airline net margin per flight.
      </p>
    </div>
    <%= link_to airline_roi_path, class: "btn btn-outline-primary" do %>
      <i class="fas fa-chart-bar me-2" aria-hidden="true"></i>Fleet ROI Dashboard
    <% end %>
  </div>

  <!-- Fleet live KPI strip -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <div class="smb-kpi-card">
        <div class="smb-kpi-label">Flights listed</div>
        <div class="smb-kpi-value"><%= @fleet_summary[:flights_count] %></div>
        <div class="smb-kpi-sub">Certified payload enforced</div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="smb-kpi-card">
        <div class="smb-kpi-label">Matched PNR weight</div>
        <div class="smb-kpi-value"><%= format_kg(@fleet_summary[:matched_kg]) %></div>
        <div class="smb-kpi-sub"><%= @fleet_summary[:trades_count] %> executed trades</div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="smb-kpi-card smb-kpi-card--emerald">
        <div class="smb-kpi-label">Airline net margin</div>
        <div class="smb-kpi-value"><%= format_euros(@fleet_summary[:airline_net_margin_cents]) %></div>
        <div class="smb-kpi-sub">After est. fuel burn (<%= format_euros(@fleet_summary[:estimated_fuel_cost_cents]) %>)</div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="smb-kpi-card smb-kpi-card--brand">
        <div class="smb-kpi-label">Voucher cash retained</div>
        <div class="smb-kpi-value"><%= format_euros(@fleet_summary[:retained_voucher_cents]) %></div>
        <div class="smb-kpi-sub"><%= @fleet_summary[:voucher_adoption_percent] %>% voucher adoption</div>
      </div>
    </div>
  </div>

  <!-- Search & airline filter -->
  <section class="smb-card p-3 mb-4" aria-label="Filter flights">
    <%= form_with url: flights_path, method: :get, local: true, class: "row g-2 align-items-end" do |f| %>
      <div class="col-md-6">
        <%= f.label :q, "Search flight, airport IATA, city, or aircraft", class: "form-label small mb-1" %>
        <%= f.text_field :q, value: params[:q], class: "form-control", placeholder: "e.g. AF718, CDG, Dakar, A350-900..." %>
      </div>
      <div class="col-md-4">
        <%= f.label :airline, "Carrier", class: "form-label small mb-1" %>
        <%= f.select :airline,
            options_for_select([["All partner airlines", ""]] + @airlines.map { |code, name| ["#{name} (#{code})", code] }, params[:airline]),
            {}, class: "form-select" %>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <%= f.submit "Filter", class: "btn btn-primary w-100" %>
        <% if params[:q].present? || params[:airline].present? %>
          <%= link_to "Reset", flights_path, class: "btn btn-outline-secondary" %>
        <% end %>
      </div>
    <% end %>
  </section>

  <% if @flights.any? %>
    <div class="smb-card overflow-hidden">
      <div class="table-responsive">
        <table class="table smb-orderbook-table align-middle mb-0">
          <caption class="visually-hidden">Commercial flights with open baggage allowance Bid/Ask order books</caption>
          <thead>
            <tr>
              <th scope="col">Flight &amp; Aircraft</th>
              <th scope="col">Route &amp; Cutoff</th>
              <th scope="col">Best Bid / Ask</th>
              <th scope="col">Book Depth</th>
              <th scope="col">Aircraft Payload</th>
              <th scope="col">Airline Net Margin</th>
              <th scope="col"><span class="visually-hidden">Action</span></th>
            </tr>
          </thead>
          <tbody>
            <% @flights.each do |flight| %>
              <% econ = AirlineEconomicsService.flight_summary(flight) %>
              <tr>
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <span class="smb-airline-code" aria-hidden="true"><%= flight.airline_code %></span>
                    <div>
                      <div class="fw-bold text-dark"><%= flight.flight_number %> · <%= flight.airline_name %></div>
                      <div class="small text-muted"><%= flight.aircraft_type.aircraft_name %> · <%= flight.aircraft_type.seat_capacity %> seats</div>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="fw-bold text-dark"><%= flight.departure_iata %> → <%= flight.arrival_iata %></div>
                  <div class="small text-muted"><%= flight.departure_city %> to <%= flight.arrival_city %></div>
                  <div class="small">
                    <% if flight.trading_open? %>
                      <span class="text-success fw-semibold">Closes in <%= flight.hours_until_cutoff %>h</span>
                    <% else %>
                      <span class="text-muted">Cutoff reached</span>
                    <% end %>
                  </div>
                </td>
                <td class="smb-tabular">
                  <div>
                    <span class="smb-price-bid">BID <%= format_euros(flight.best_bid_cents) %></span>
                    <span class="text-muted mx-1">/</span>
                    <span class="smb-price-ask">ASK <%= format_euros(flight.best_ask_cents) %></span>
                  </div>
                  <div class="small text-muted">
                    Airport desk: <%= format_euros(flight.airport_excess_fee_per_kg_cents) %>/kg
                    <% if flight.estimated_savings_percent_vs_airport > 0 %>
                      · <strong class="text-success">-<%= flight.estimated_savings_percent_vs_airport %>%</strong>
                    <% end %>
                  </div>
                </td>
                <td class="smb-tabular">
                  <div class="small"><strong>Demand:</strong> <%= format_kg(flight.total_demand_kg) %></div>
                  <div class="small"><strong>Supply:</strong> <%= format_kg(flight.total_supply_kg) %></div>
                  <div class="small text-muted">Matched: <%= format_kg(flight.total_matched_kg) %></div>
                </td>
                <td>
                  <div class="small fw-semibold text-dark mb-1">
                    <%= format_kg(flight.current_total_baggage_kg) %> / <%= format_kg(flight.max_baggage_payload_kg) %> (<%= flight.payload_utilization_percent %>%)
                  </div>
                  <div class="smb-payload-meter" role="progressbar"
                       aria-label="Payload utilization for <%= flight.flight_number %>"
                       aria-valuenow="<%= flight.payload_utilization_percent.round %>"
                       aria-valuemin="0" aria-valuemax="100">
                    <div class="smb-payload-bar <%= percent_width_class(flight.payload_utilization_percent) %>"></div>
                  </div>
                </td>
                <td class="smb-tabular">
                  <div class="fw-bold text-success"><%= format_euros(econ[:airline_net_margin_cents]) %></div>
                  <div class="small text-muted">Fee: <%= format_euros(econ[:airline_commission_cents]) %> (<%= flight.commission_percent %>%)</div>
                </td>
                <td class="text-end">
                  <%= link_to "Open Order Book", flight_path(flight), class: "btn btn-sm btn-primary" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="smb-empty-state">
      <h2 class="h5 mb-2">No matching flights found</h2>
      <p class="text-muted mb-3">Try clearing your search filter to view all open commercial departures.</p>
      <%= link_to "Show all flights", flights_path, class: "btn btn-outline-primary btn-sm" %>
    </div>
  <% end %>
</div>
