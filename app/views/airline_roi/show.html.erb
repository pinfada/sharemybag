<% provide(:title, "Airline ROI & Annual Fleet Simulator") %>

<div class="container py-4">
  <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
    <div>
      <span class="smb-b2b-pill mb-2">
        <i class="fas fa-chart-pie" aria-hidden="true"></i>
        <span>Executive B2B Business Case · Auditable Unit Economics</span>
      </span>
      <h1 class="h2 mb-1">Airline ROI &amp; Annual Fleet Simulator</h1>
      <p class="text-muted mb-0">
        Every euro below is calculated directly from executed flight trades, including marginal Jet-A1 fuel burn deduction.
      </p>
    </div>
    <%= link_to flights_path, class: "btn btn-primary" do %>
      <i class="fas fa-exchange-alt me-2" aria-hidden="true"></i>Open Live Flight Order Books
    <% end %>
  </div>

  <!-- Live Aggregated Fleet Performance -->
  <section aria-labelledby="live-fleet-heading" class="mb-4">
    <h2 id="live-fleet-heading" class="h5 mb-3">Live Exchange Performance (Executed Trades Across Demo Fleet)</h2>
    <div class="row g-3">
      <div class="col-6 col-lg-3">
        <div class="smb-kpi-card">
          <div class="smb-kpi-label">Gross Traded Volume</div>
          <div class="smb-kpi-value"><%= format_euros(@fleet_summary[:gross_volume_cents]) %></div>
          <div class="smb-kpi-sub"><%= format_kg(@fleet_summary[:matched_kg]) %> across <%= @fleet_summary[:trades_count] %> trades</div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="smb-kpi-card smb-kpi-card--brand">
          <div class="smb-kpi-label">Airline Commission (25%)</div>
          <div class="smb-kpi-value"><%= format_euros(@fleet_summary[:airline_commission_cents]) %></div>
          <div class="smb-kpi-sub">Fuel cost deducted: -<%= format_euros(@fleet_summary[:estimated_fuel_cost_cents]) %></div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="smb-kpi-card smb-kpi-card--emerald">
          <div class="smb-kpi-label">Airline Net Margin</div>
          <div class="smb-kpi-value"><%= format_euros(@fleet_summary[:airline_net_margin_cents]) %></div>
          <div class="smb-kpi-sub">Voucher cash retained: <%= format_euros(@fleet_summary[:retained_voucher_cents]) %></div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="smb-kpi-card smb-kpi-card--amber">
          <div class="smb-kpi-label">Passenger Savings</div>
          <div class="smb-kpi-value"><%= format_euros(@fleet_summary[:passenger_savings_cents]) %></div>
          <div class="smb-kpi-sub">Saved vs airport excess desk</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Annual Fleet ROI Simulator -->
  <section class="smb-card p-4 mb-4" aria-labelledby="simulator-heading" data-roi-simulator>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
      <div>
        <h2 id="simulator-heading" class="h4 mb-1">Interactive Annual Fleet ROI Simulator</h2>
        <p class="text-muted small mb-0">Adjust your carrier's fleet volume and parameters to model annual net ancillary profit and cash retention.</p>
      </div>
      <span class="smb-badge smb-badge--emerald">Real-Time Formula</span>
    </div>

    <div class="row g-4">
      <div class="col-lg-6">
        <div class="row g-3">
          <div class="col-sm-6">
            <label for="sim_daily_flights" class="form-label">Daily commercial flights</label>
            <input type="number" id="sim_daily_flights" class="form-control" value="120" min="1" max="5000" step="10" data-roi-daily-flights>
            <div class="form-text">e.g. 120 flights/day = 43,800/yr</div>
          </div>
          <div class="col-sm-6">
            <label for="sim_kg_flight" class="form-label">Avg matched weight / flight (kg)</label>
            <input type="number" id="sim_kg_flight" class="form-control" value="180" min="10" max="1500" step="10" data-roi-kg-per-flight>
            <div class="form-text">~18–25 trades per departure</div>
          </div>
          <div class="col-sm-6">
            <label for="sim_spot_price" class="form-label">Avg market clearing price (€/kg)</label>
            <input type="number" id="sim_spot_price" class="form-control" value="7.50" min="2" max="25" step="0.50" data-roi-spot-price>
          </div>
          <div class="col-sm-6">
            <label for="sim_commission" class="form-label">Airline commission (%)</label>
            <input type="number" id="sim_commission" class="form-control" value="25" min="5" max="45" step="1" data-roi-commission>
          </div>
          <div class="col-sm-4">
            <label for="sim_voucher_rate" class="form-label">Voucher payout (%)</label>
            <input type="number" id="sim_voucher_rate" class="form-control" value="75" min="0" max="100" step="5" data-roi-voucher-rate>
          </div>
          <div class="col-sm-4">
            <label for="sim_duration" class="form-label">Avg flight duration (h)</label>
            <input type="number" id="sim_duration" class="form-control" value="4.5" min="1" max="14" step="0.5" data-roi-duration>
          </div>
          <div class="col-sm-4">
            <label for="sim_airport_fee" class="form-label">Airport desk fee (€/kg)</label>
            <input type="number" id="sim_airport_fee" class="form-control" value="15.00" min="5" max="40" step="1" data-roi-airport-fee>
          </div>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="p-4 rounded bg-light border h-100 d-flex flex-column justify-content-between">
          <div>
            <div class="small text-uppercase fw-bold text-muted mb-1">Projected Annual Airline Net Ancillary Profit</div>
            <div class="display-6 fw-bold text-success mb-3 smb-tabular" aria-live="polite" data-roi-annual-margin>
              <%= format_euros(@default_projection[:annual_net_margin_cents]) %>
            </div>

            <div class="row g-3 small">
              <div class="col-6">
                <div class="text-muted">Gross Commission Revenue</div>
                <div class="fw-bold fs-6 text-dark smb-tabular" data-roi-annual-commission>
                  <%= format_euros(@default_projection[:annual_commission_cents]) %>
                </div>
              </div>
              <div class="col-6">
                <div class="text-muted">Marginal Jet-A1 Fuel Cost</div>
                <div class="fw-bold fs-6 text-danger smb-tabular" data-roi-annual-fuel>
                  <%= format_euros(@default_projection[:annual_fuel_cost_cents]) %>
                </div>
              </div>
              <div class="col-6">
                <div class="text-muted">Retained Voucher Treasury</div>
                <div class="fw-bold fs-6 text-primary smb-tabular" data-roi-annual-voucher>
                  <%= format_euros(@default_projection[:annual_retained_voucher_cents]) %>
                </div>
              </div>
              <div class="col-6">
                <div class="text-muted">Total Cash Kept in Ecosystem</div>
                <div class="fw-bold fs-6 text-success smb-tabular" data-roi-annual-cash>
                  <%= format_euros(@default_projection[:annual_total_cash_retained_cents]) %>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center small">
            <span class="text-muted">Annual Passenger Savings vs Counter Fees:</span>
            <strong class="text-primary fs-6 smb-tabular" data-roi-annual-savings>
              <%= format_euros(@default_projection[:annual_passenger_savings_cents]) %>
            </strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Auditable Formulas & Aviation Compliance Proof -->
  <div class="row g-4 mb-4">
    <div class="col-lg-6">
      <div class="smb-formula-box h-100">
        <h2 class="h6 mb-2"><i class="fas fa-flask me-2 text-primary" aria-hidden="true"></i>Transparent Aviation Economics Formulas</h2>
        <ul class="mb-0 ps-3 d-grid gap-1 text-muted">
          <li><strong>Gross Volume</strong> = Matched kg × Maker Execution Price (€/kg)</li>
          <li><strong>Airline Commission</strong> = Gross Volume × Commission Rate (default 25%)</li>
          <li><strong>Marginal Jet-A1 Fuel Burn</strong> = Matched kg × 3.5%/hour × Flight Hours × €1.10/kg</li>
          <li><strong>Airline Net Margin</strong> = Airline Commission − Marginal Fuel Cost</li>
          <li><strong>Retained Voucher Treasury</strong> = 100% of voucher payouts stay on the airline's balance sheet for future ticket bookings</li>
        </ul>
      </div>
    </div>
    <div class="col-lg-6">
      <div class="smb-formula-box h-100">
        <h2 class="h6 mb-2"><i class="fas fa-check-circle me-2 text-success" aria-hidden="true"></i>Operational &amp; Regulatory Guarantees</h2>
        <ul class="mb-0 ps-3 d-grid gap-1 text-muted">
          <li><strong>Zero Airport Security Risk</strong>: no physical item ever passes between strangers; every bag is packed and owned by its ticketed passenger.</li>
          <li><strong>Certified Aircraft Payload Cap</strong>: 1:1 PNR transfers keep total booked tonnage strictly within aircraft structural &amp; MTOW limits.</li>
          <li><strong>H-4h Weight &amp; Balance Cutoff</strong>: exchange freezes 4 hours before departure so dispatch loadsheets remain untouched.</li>
          <li><strong>IATA 32 kg Health &amp; Safety Limit</strong>: PNR allowances above 32 kg require splitting across 2 separate checked pieces.</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Flight-by-Flight Breakdown Table -->
  <section class="smb-card overflow-hidden" aria-labelledby="flight-breakdown-heading">
    <div class="px-4 py-3 border-bottom">
      <h2 id="flight-breakdown-heading" class="h6 mb-0">Live Flight-by-Flight Economics Breakdown</h2>
    </div>
    <div class="table-responsive">
      <table class="table smb-orderbook-table mb-0">
        <caption class="visually-hidden">Per-flight volume, commission, fuel burn, and airline net margin</caption>
        <thead>
          <tr>
            <th scope="col">Flight</th>
            <th scope="col">Aircraft</th>
            <th scope="col">Matched kg</th>
            <th scope="col">Gross Volume</th>
            <th scope="col">Airline Fee</th>
            <th scope="col">Est. Fuel</th>
            <th scope="col">Net Margin</th>
            <th scope="col">Voucher Retained</th>
          </tr>
        </thead>
        <tbody>
          <% @flight_rows.each do |row| %>
            <% flight = row[:flight] %>
            <% s = row[:summary] %>
            <tr>
              <td>
                <%= link_to flight.flight_number, flight_path(flight), class: "fw-bold" %>
                <div class="small text-muted"><%= flight.route_label %></div>
              </td>
              <td class="small"><%= flight.aircraft_type.code %> (<%= flight.flight_duration_hours %>h)</td>
              <td class="smb-tabular fw-semibold"><%= format_kg(s[:matched_kg]) %></td>
              <td class="smb-tabular"><%= format_euros(s[:gross_volume_cents]) %></td>
              <td class="smb-tabular text-primary fw-semibold"><%= format_euros(s[:airline_commission_cents]) %></td>
              <td class="smb-tabular text-muted">-<%= format_euros(s[:estimated_fuel_cost_cents]) %></td>
              <td class="smb-tabular text-success fw-bold"><%= format_euros(s[:airline_net_margin_cents]) %></td>
              <td class="smb-tabular"><%= format_euros(s[:retained_voucher_cents]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
