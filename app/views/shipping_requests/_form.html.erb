<%= render "shared/error_messages", object: @shipping_request %>

<p class="small text-muted mb-3">Fields marked with <span class="smb-required" aria-hidden="true">*</span><span class="visually-hidden">an asterisk</span> are required.</p>

<%= form_with model: @shipping_request, local: true do |f| %>
  <fieldset class="smb-fieldset">
    <legend>1. Route &amp; dates</legend>
    <div class="row g-3">
      <div class="col-md-6">
        <%= f.label :departure_city, class: "form-label" do %>
          Departure city <span class="smb-required" aria-hidden="true">*</span>
        <% end %>
        <%= f.text_field :departure_city, { class: "form-control", placeholder: "e.g. London" }.merge(field_a11y_attrs(@shipping_request, :departure_city, required: true)) %>
      </div>
      <div class="col-md-6">
        <%= f.label :departure_country, class: "form-label" do %>
          Departure country <span class="smb-required" aria-hidden="true">*</span>
        <% end %>
        <%= f.text_field :departure_country, { class: "form-control", placeholder: "e.g. United Kingdom" }.merge(field_a11y_attrs(@shipping_request, :departure_country, required: true)) %>
      </div>
      <div class="col-md-6">
        <%= f.label :arrival_city, class: "form-label" do %>
          Arrival city <span class="smb-required" aria-hidden="true">*</span>
        <% end %>
        <%= f.text_field :arrival_city, { class: "form-control", placeholder: "e.g. Dakar" }.merge(field_a11y_attrs(@shipping_request, :arrival_city, required: true)) %>
      </div>
      <div class="col-md-6">
        <%= f.label :arrival_country, class: "form-label" do %>
          Arrival country <span class="smb-required" aria-hidden="true">*</span>
        <% end %>
        <%= f.text_field :arrival_country, { class: "form-control", placeholder: "e.g. Senegal" }.merge(field_a11y_attrs(@shipping_request, :arrival_country, required: true)) %>
      </div>
      <div class="col-md-6">
        <%= f.label :desired_date, class: "form-label" do %>
          Desired departure date <span class="smb-required" aria-hidden="true">*</span>
        <% end %>
        <%= f.date_field :desired_date, { class: "form-control", min: Date.current }.merge(field_a11y_attrs(@shipping_request, :desired_date, required: true)) %>
      </div>
      <div class="col-md-6">
        <%= f.label :deadline_date, "Latest arrival date (optional)", class: "form-label" %>
        <%= f.date_field :deadline_date, { class: "form-control", min: Date.current }.merge(field_a11y_attrs(@shipping_request, :deadline_date)) %>
      </div>
    </div>
  </fieldset>

  <fieldset class="smb-fieldset">
    <legend>2. Parcel details</legend>
    <div class="mb-3">
      <%= f.label :title, class: "form-label" do %>
        Request title <span class="smb-required" aria-hidden="true">*</span>
      <% end %>
      <%= f.text_field :title, { class: "form-control", placeholder: "e.g. School textbooks to Dakar" }.merge(field_a11y_attrs(@shipping_request, :title, required: true)) %>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-md-3">
        <%= f.label :weight_kg, class: "form-label" do %>
          Weight (kg) <span class="smb-required" aria-hidden="true">*</span>
        <% end %>
        <%= f.number_field :weight_kg, { class: "form-control", min: 0.5, max: 50, step: 0.5, placeholder: "e.g. 5" }.merge(field_a11y_attrs(@shipping_request, :weight_kg, required: true)) %>
      </div>
      <div class="col-md-3">
        <%= f.label :max_budget_euros, "Max budget (€)", class: "form-label" %>
        <%= f.number_field :max_budget_euros, { class: "form-control", min: 1, max: 5000, step: 1, placeholder: "e.g. 60" }.merge(field_a11y_attrs(@shipping_request, :max_budget_cents)) %>
      </div>
      <div class="col-md-3">
        <%= f.label :declared_value_euros, "Contents value (€)", class: "form-label" %>
        <%= f.number_field :declared_value_euros, { class: "form-control", min: 1, max: 10000, step: 1, placeholder: "e.g. 120" }.merge(field_a11y_attrs(@shipping_request, :declared_value_cents, describedby: "declared-value-hint")) %>
      </div>
      <div class="col-md-3">
        <%= f.label :item_category, "Category", class: "form-label" %>
        <%= f.select :item_category,
            ShippingRequest::CATEGORIES.map { |c| [t("categories.#{c}"), c] },
            { include_blank: "Select..." },
            { class: "form-select" }.merge(field_a11y_attrs(@shipping_request, :item_category)) %>
      </div>
      <div class="col-12 mt-1">
        <div id="declared-value-hint" class="form-text">On international flights, declaring an honest contents value helps travelers anticipate customs thresholds (e.g. €430 EU air duty-free limit).</div>
      </div>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-4">
        <%= f.label :length_cm, "Length (cm)", class: "form-label" %>
        <%= f.number_field :length_cm, { class: "form-control", min: 1, max: 200, placeholder: "Optional" }.merge(field_a11y_attrs(@shipping_request, :length_cm)) %>
      </div>
      <div class="col-4">
        <%= f.label :width_cm, "Width (cm)", class: "form-label" %>
        <%= f.number_field :width_cm, { class: "form-control", min: 1, max: 200, placeholder: "Optional" }.merge(field_a11y_attrs(@shipping_request, :width_cm)) %>
      </div>
      <div class="col-4">
        <%= f.label :height_cm, "Height (cm)", class: "form-label" %>
        <%= f.number_field :height_cm, { class: "form-control", min: 1, max: 200, placeholder: "Optional" }.merge(field_a11y_attrs(@shipping_request, :height_cm)) %>
      </div>
    </div>

    <div class="mb-3">
      <%= f.label :description, "Contents description", class: "form-label" %>
      <%= f.text_area :description, { class: "form-control", rows: 3, placeholder: "Clearly describe the items inside to build trust with travelers." }.merge(field_a11y_attrs(@shipping_request, :description)) %>
    </div>

    <div class="mb-0">
      <%= f.label :special_instructions, "Special instructions (optional)", class: "form-label" %>
      <%= f.text_area :special_instructions, { class: "form-control", rows: 2, placeholder: "e.g. Fragile, handover available near central station." }.merge(field_a11y_attrs(@shipping_request, :special_instructions)) %>
    </div>
  </fieldset>

  <% if @shipping_request.new_record? %>
    <fieldset class="smb-fieldset">
      <legend>3. Safety pledge</legend>
      <p id="safety-pledge-hint" class="small text-muted mb-3">
        Illegal goods, dangerous materials, flammable liquids, weapons, counterfeit items, and cash are strictly forbidden. Travelers inspect open contents before taking custody.
      </p>
      <div class="form-check">
        <%= f.check_box :prohibited_items_acknowledged, { class: "form-check-input" }.merge(field_a11y_attrs(@shipping_request, :prohibited_items_acknowledged, required: true, describedby: "safety-pledge-hint")) %>
        <%= f.label :prohibited_items_acknowledged, class: "form-check-label fw-semibold" do %>
          I confirm that this parcel contains no items prohibited in air transport and agree to an open visual check at handover. <span class="smb-required" aria-hidden="true">*</span>
        <% end %>
      </div>
    </fieldset>
  <% end %>

  <div class="d-flex gap-2">
    <%= f.submit @shipping_request.new_record? ? "Publish request" : "Save changes", class: "btn btn-primary btn-lg px-4" %>
    <%= link_to "Cancel", @shipping_request.new_record? ? shipping_requests_path : shipping_request_path(@shipping_request), class: "btn btn-outline-secondary btn-lg" %>
  </div>
<% end %>
