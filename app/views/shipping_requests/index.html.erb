<% provide(:title, "Open shipping requests") %>

<div class="container py-5">
  <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
      <h1 class="h2 mb-1">Open shipping requests</h1>
      <p class="text-muted mb-0">Browse parcels looking for a carrier and submit your price per kilo.</p>
    </div>
    <%= link_to new_shipping_request_path, class: "btn btn-primary px-4" do %>
      <i class="fas fa-plus me-2" aria-hidden="true"></i>Post a request
    <% end %>
  </div>

  <section class="smb-card p-3 p-md-4 mb-4" aria-label="Filter shipping requests">
    <%= form_with url: shipping_requests_path, method: :get, local: true, role: "search", class: "row g-3 align-items-end" do %>
      <div class="col-md-3">
        <%= label_tag :departure_city, "Departure", class: "form-label" %>
        <%= text_field_tag :departure_city, params[:departure_city], class: "form-control", placeholder: "City or country" %>
      </div>
      <div class="col-md-3">
        <%= label_tag :arrival_city, "Arrival", class: "form-label" %>
        <%= text_field_tag :arrival_city, params[:arrival_city], class: "form-control", placeholder: "City or country" %>
      </div>
      <div class="col-6 col-md-2">
        <%= label_tag :max_weight, "Max weight (kg)", class: "form-label" %>
        <%= number_field_tag :max_weight, params[:max_weight], class: "form-control", min: 0.5, max: 50, step: 0.5, placeholder: "e.g. 10" %>
      </div>
      <div class="col-6 col-md-2">
        <%= label_tag :date_from, "Earliest date", class: "form-label" %>
        <%= date_field_tag :date_from, params[:date_from], class: "form-control" %>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
        <% if params[:departure_city].present? || params[:arrival_city].present? || params[:max_weight].present? || params[:date_from].present? %>
          <%= link_to shipping_requests_path, class: "btn btn-outline-secondary", aria: { label: "Reset all filters" }, title: "Reset all filters" do %>
            <span aria-hidden="true">×</span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </section>

  <% if @shipping_requests.any? %>
    <section aria-labelledby="results-heading">
      <h2 id="results-heading" class="visually-hidden">Matching shipping requests</h2>
      <div class="row g-4">
        <% @shipping_requests.each do |req| %>
          <div class="col-md-6 col-lg-4">
            <%= render "shipping_requests/card", shipping_request: req %>
          </div>
        <% end %>
      </div>
    </section>

    <nav aria-label="Pagination" class="mt-4">
      <%= will_paginate @shipping_requests, previous_label: "← Previous", next_label: "Next →" %>
    </nav>
  <% else %>
    <div class="smb-empty-state">
      <h2 class="h5 mb-2">No requests match your filters</h2>
      <p class="text-muted mb-3">Try broadening your search or post your own shipping request.</p>
      <div class="d-flex justify-content-center gap-2">
        <%= link_to "View all requests", shipping_requests_path, class: "btn btn-outline-secondary" %>
        <%= link_to "Post a request", new_shipping_request_path, class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</div>
