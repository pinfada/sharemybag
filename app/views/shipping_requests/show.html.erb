<% provide(:title, @shipping_request.title) %>

<div class="container py-5">
  <div class="mb-3">
    <%= link_to "← Back to shipping requests", shipping_requests_path, class: "small" %>
  </div>

  <div class="row gy-4">
    <div class="col-lg-8">
      <article class="smb-card p-4 mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
          <span class="<%= status_badge_class(@shipping_request.status) %>">
            <%= t("statuses.#{@shipping_request.status}") %>
          </span>
          <span class="small text-muted">
            Posted on <%= l(@shipping_request.created_at.to_date, format: :long) %>
          </span>
        </div>

        <h1 class="h3 mb-3"><%= @shipping_request.title %></h1>

        <div class="smb-route fs-5 mb-4 pb-3 border-bottom">
          <span><%= @shipping_request.departure_city %> <span class="smb-route-country">(<%= @shipping_request.departure_country %>)</span></span>
          <i class="fas fa-plane smb-route-arrow" aria-hidden="true"></i>
          <span class="visually-hidden">to</span>
          <span><%= @shipping_request.arrival_city %> <span class="smb-route-country">(<%= @shipping_request.arrival_country %>)</span></span>
        </div>

        <dl class="row g-3 mb-4">
          <div class="col-6 col-md-3">
            <dt class="small text-muted fw-normal">Weight</dt>
            <dd class="fw-bold text-dark mb-0"><%= number_with_precision(@shipping_request.weight_kg, strip_insignificant_zeros: true) %> kg</dd>
          </div>
          <div class="col-6 col-md-3">
            <dt class="small text-muted fw-normal">Desired date</dt>
            <dd class="fw-bold text-dark mb-0"><%= l(@shipping_request.desired_date, format: :short) %></dd>
          </div>
          <% if @shipping_request.max_budget_cents.present? %>
            <div class="col-6 col-md-3">
              <dt class="small text-muted fw-normal">Maximum budget</dt>
              <dd class="fw-bold text-dark mb-0"><%= format_euros(@shipping_request.max_budget_cents) %></dd>
            </div>
          <% end %>
          <% if @shipping_request.item_category.present? %>
            <div class="col-6 col-md-3">
              <dt class="small text-muted fw-normal">Category</dt>
              <dd class="fw-bold text-dark mb-0"><%= t("categories.#{@shipping_request.item_category}", default: @shipping_request.item_category) %></dd>
            </div>
          <% end %>
        </dl>

        <% if @shipping_request.length_cm.present? && @shipping_request.width_cm.present? && @shipping_request.height_cm.present? %>
          <p class="small text-muted mb-3">
            <strong class="text-dark">Dimensions:</strong>
            <%= @shipping_request.length_cm.to_i %> × <%= @shipping_request.width_cm.to_i %> × <%= @shipping_request.height_cm.to_i %> cm
          </p>
        <% end %>

        <% if @shipping_request.deadline_date.present? %>
          <p class="small text-muted mb-3">
            <strong class="text-dark">Arrival deadline:</strong>
            <%= l(@shipping_request.deadline_date, format: :long) %>
          </p>
        <% end %>

        <% if @shipping_request.declared_value_cents.present? %>
          <p class="small text-muted mb-3">
            <strong class="text-dark">Declared contents value:</strong>
            <%= format_euros(@shipping_request.declared_value_cents) %>
          </p>
        <% end %>

        <% if @shipping_request.description.present? %>
          <div class="mb-3">
            <h2 class="h6 mb-1">Parcel description</h2>
            <p class="text-muted mb-0"><%= @shipping_request.description %></p>
          </div>
        <% end %>

        <% if @shipping_request.special_instructions.present? %>
          <div class="mb-3">
            <h2 class="h6 mb-1">Special instructions</h2>
            <p class="text-muted mb-0"><%= @shipping_request.special_instructions %></p>
          </div>
        <% end %>

        <div class="small text-success pt-2 border-top fw-semibold">
          <i class="fas fa-shield-alt me-1" aria-hidden="true"></i>
          The sender confirmed this parcel contains no items prohibited in air transport.
        </div>

        <% if @shipping_request.international? %>
          <div class="alert <%= @shipping_request.above_customs_allowance? ? 'alert-warning' : 'alert-light border' %> mt-3 mb-0 small" role="note">
            <div class="fw-bold text-dark mb-1">
              <i class="fas fa-passport me-1" aria-hidden="true"></i>
              International flight — Aviation security &amp; customs notice
            </div>
            <% if @shipping_request.above_customs_allowance? %>
              <p class="mb-1 text-dark">
                <strong>Customs declaration required:</strong> declared value (<%= format_euros(@shipping_request.declared_value_cents) %>) exceeds the standard €430 air traveler duty-free allowance. The traveler must declare these items at arrival customs.
              </p>
            <% end %>
            <p class="mb-0 text-muted">
              Never accept a sealed parcel: for airport security compliance, the traveler must open, visually inspect every item, and pack it personally at handover.
            </p>
          </div>
        <% end %>
      </article>

      <% if @tracking && signed_in? && @tracking.participant?(current_user) %>
        <section class="smb-card smb-card--highlight p-4 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3" aria-label="Active shipment tracking">
          <div>
            <h2 class="h6 fw-bold text-dark mb-1">Secure tracking active</h2>
            <div class="small text-muted">
              Current stage: <strong><%= t("tracking.statuses.#{@tracking.status}") %></strong>
            </div>
          </div>
          <%= link_to "Open tracking & codes →", shipment_tracking_path(@tracking), class: "btn btn-success" %>
        </section>
      <% end %>

      <section class="mb-4" aria-labelledby="offers-heading">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 id="offers-heading" class="h4 mb-0">Traveler offers (<%= @bids.size %>)</h2>
        </div>

        <% if @bids.any? %>
          <ul class="d-flex flex-column gap-3 list-unstyled mb-0">
            <% @bids.each do |bid| %>
              <li class="smb-card p-4 <%= 'smb-card--highlight' if bid.status == 'accepted' %>">
                <div class="row align-items-center gy-3">
                  <div class="col-md-5">
                    <div class="d-flex align-items-center gap-2 mb-1">
                      <%= user_avatar(bid.traveler, size: :sm) %>
                      <div>
                        <div class="fw-bold">
                          <%= link_to bid.traveler.name, user_path(bid.traveler), class: "text-dark" %>
                        </div>
                        <div class="small text-muted">
                          <i class="fas fa-star smb-star-filled me-1" aria-hidden="true"></i>
                          <%= bid.traveler.reviews_count > 0 ? "#{bid.traveler.average_rating}/5" : "New member" %>
                          · <%= pluralize(bid.traveler.completed_shipments_count, "confirmed delivery", "confirmed deliveries") %>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="col-md-4">
                    <div class="fw-bold text-dark fs-5"><%= format_euros(bid.total_price_cents) %></div>
                    <div class="small text-muted">
                      <%= format_euros(bid.price_per_kg_cents) %> / kg · <%= number_with_precision(bid.available_kg, strip_insignificant_zeros: true) %> kg available
                    </div>
                    <div class="small text-muted">
                      Flight on <%= l(bid.travel_date, format: :short) %><%= " · #{bid.flight_number}" if bid.flight_number.present? %>
                    </div>
                  </div>

                  <div class="col-md-3 text-md-end">
                    <div class="mb-2">
                      <span class="<%= status_badge_class(bid.status) %>"><%= t("statuses.#{bid.status}") %></span>
                    </div>

                    <% if signed_in? && @shipping_request.sender_id == current_user.id && @shipping_request.open_for_bids? && bid.status == "pending" %>
                      <%= button_to "Accept offer",
                          accept_bid_shipping_request_path(@shipping_request, bid_id: bid.id),
                          method: :post,
                          class: "btn btn-success btn-sm w-100",
                          form: { data: { confirm_message: "Accept #{bid.traveler.name}'s offer for #{format_euros(bid.total_price_cents)}? Other pending offers will be closed." } } %>
                    <% elsif signed_in? && bid.traveler_id == current_user.id && bid.withdrawable? %>
                      <%= button_to "Withdraw offer",
                          withdraw_shipping_request_bid_path(@shipping_request, bid),
                          method: :patch,
                          class: "btn btn-outline-secondary btn-sm w-100",
                          form: { data: { confirm_message: "Withdraw your offer?" } } %>
                    <% end %>
                  </div>
                </div>

                <% if bid.message.present? %>
                  <div class="mt-3 pt-3 border-top small text-muted">
                    “<%= bid.message %>”
                  </div>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="smb-empty-state">
            <p class="text-muted mb-0">No offers yet. Be the first traveler on this route to propose a rate!</p>
          </div>
        <% end %>
      </section>

      <% if @shipping_request.open_for_bids? %>
        <% if !signed_in? %>
          <section class="smb-card p-4 text-center" aria-labelledby="signin-bid-heading">
            <h2 id="signin-bid-heading" class="h5 mb-2">Flying this route?</h2>
            <p class="text-muted mb-3">Sign in to propose your price per kilo to the sender.</p>
            <%= link_to "Sign in to submit an offer", signin_path, class: "btn btn-primary" %>
          </section>
        <% elsif current_user.id != @shipping_request.sender_id && @existing_user_bid.nil? %>
          <section class="smb-card p-4" aria-labelledby="bid-form-heading">
            <h2 id="bid-form-heading" class="h5 mb-1">Submit a transport offer</h2>
            <p class="small text-muted mb-3">
              Enter your rate per kilo in euros. The total price is calculated automatically for <%= number_with_precision(@shipping_request.weight_kg, strip_insignificant_zeros: true) %> kg.
            </p>

            <%= form_with model: [@shipping_request, @bid], local: true do |f| %>
              <div class="row g-3 mb-3">
                <div class="col-sm-4">
                  <%= f.label :price_per_kg_euros, class: "form-label" do %>
                    Price per kg (€) <span class="smb-required" aria-hidden="true">*</span>
                  <% end %>
                  <%= f.number_field :price_per_kg_euros,
                      class: "form-control",
                      min: 1, max: 1000, step: 0.5, required: true, "aria-required": "true",
                      placeholder: "e.g. 10.00",
                      data: { bid_price_input: true, request_weight: @shipping_request.weight_kg } %>
                </div>
                <div class="col-sm-4">
                  <%= f.label :available_kg, class: "form-label" do %>
                    Available capacity (kg) <span class="smb-required" aria-hidden="true">*</span>
                  <% end %>
                  <%= f.number_field :available_kg,
                      class: "form-control",
                      min: @shipping_request.weight_kg, max: 50, step: 0.5, required: true, "aria-required": "true" %>
                </div>
                <div class="col-sm-4">
                  <%= f.label :travel_date, class: "form-label" do %>
                    Travel date <span class="smb-required" aria-hidden="true">*</span>
                  <% end %>
                  <%= f.date_field :travel_date, class: "form-control", min: Date.current, required: true, "aria-required": "true" %>
                </div>
              </div>

              <div class="smb-price-preview d-flex justify-content-between align-items-center mb-3">
                <span class="small">Estimated total (<%= number_with_precision(@shipping_request.weight_kg, strip_insignificant_zeros: true) %> kg)</span>
                <strong class="fs-5" aria-live="polite" aria-atomic="true" data-bid-total-output>—</strong>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-sm-4">
                  <%= f.label :flight_number, "Flight number (optional)", class: "form-label" %>
                  <%= f.text_field :flight_number, class: "form-control", placeholder: "e.g. AF718" %>
                </div>
                <div class="col-sm-8">
                  <%= f.label :message, "Message to sender", class: "form-label" %>
                  <%= f.text_field :message, class: "form-control", placeholder: "Share your handover availability..." %>
                </div>
              </div>

              <%= f.submit "Submit offer", class: "btn btn-primary px-4" %>
            <% end %>
          </section>
        <% end %>
      <% end %>
    </div>

    <aside class="col-lg-4" aria-label="Sender details and actions">
      <div class="smb-card p-4 mb-3">
        <h2 class="h6 text-muted mb-2">Sender</h2>
        <div class="d-flex align-items-center gap-3 mb-3">
          <%= user_avatar(@shipping_request.sender, size: :md) %>
          <div>
            <div class="fw-bold">
              <%= link_to @shipping_request.sender.name, user_path(@shipping_request.sender), class: "text-dark" %>
            </div>
            <div class="small text-muted">
              <i class="fas fa-star smb-star-filled me-1" aria-hidden="true"></i>
              <%= @shipping_request.sender.reviews_count > 0 ? "#{@shipping_request.sender.average_rating}/5" : "New member" %>
            </div>
          </div>
        </div>

        <% if signed_in? && current_user.id != @shipping_request.sender_id %>
          <%= button_to "Message sender",
              conversations_path(recipient_id: @shipping_request.sender_id, shipping_request_id: @shipping_request.id),
              method: :post,
              class: "btn btn-outline-primary w-100" %>
        <% end %>
      </div>

      <% if signed_in? && @shipping_request.sender_id == current_user.id && @shipping_request.editable? %>
        <div class="smb-card p-4">
          <h2 class="h6 text-muted mb-3">Manage request</h2>
          <div class="d-grid gap-2">
            <%= link_to "Edit request", edit_shipping_request_path(@shipping_request), class: "btn btn-outline-secondary" %>
            <%= button_to "Cancel request",
                shipping_request_path(@shipping_request),
                method: :delete,
                class: "btn btn-outline-danger w-100",
                form: { data: { confirm_message: "Permanently cancel this shipping request?" } } %>
          </div>
        </div>
      <% end %>
    </aside>
  </div>
</div>
