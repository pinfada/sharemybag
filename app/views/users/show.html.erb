<% provide(:title, @user.name) %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <section class="smb-card p-4 p-md-5">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
          <div class="d-flex align-items-center gap-3">
            <%= user_avatar(@user, size: :lg) %>
            <div>
              <h1 class="h3 mb-1"><%= @user.name %></h1>
              <div class="small text-muted">
                <% if @user.city.present? || @user.country.present? %>
                  <i class="fas fa-map-marker-alt me-1" aria-hidden="true"></i>
                  <%= [@user.city, @user.country].compact_blank.join(", ") %> ·
                <% end %>
                <%= @user.airline_admin? ? "Airline Revenue Administrator" : "Verified Exchange Passenger" %>
              </div>
            </div>
          </div>

          <% if current_user?(@user) %>
            <div class="d-flex gap-2">
              <%= link_to "My PNR Bookings", my_bookings_path, class: "btn btn-primary btn-sm" %>
              <%= link_to "Edit profile", edit_user_path(@user), class: "btn btn-outline-secondary btn-sm" %>
            </div>
          <% end %>
        </div>

        <% if @user.bio.present? %>
          <p class="text-muted mb-4"><%= @user.bio %></p>
        <% end %>

        <div class="row g-3">
          <div class="col-sm-4">
            <div class="smb-kpi-card">
              <div class="smb-kpi-label">Completed Transfers</div>
              <div class="smb-kpi-value"><%= @completed_trades_count %></div>
            </div>
          </div>
          <div class="col-sm-4">
            <div class="smb-kpi-card">
              <div class="smb-kpi-label">Active Bookings</div>
              <div class="smb-kpi-value"><%= @booked_flights_count %></div>
            </div>
          </div>
          <div class="col-sm-4">
            <div class="smb-kpi-card">
              <div class="smb-kpi-label">Member Since</div>
              <div class="smb-kpi-value fs-4"><%= @user.created_at.strftime("%b %Y") %></div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>
