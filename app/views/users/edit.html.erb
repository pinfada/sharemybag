<% provide(:title, "Profile settings") %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="smb-card p-4 p-md-5">
        <h1 class="h3 mb-1">Profile settings</h1>
        <p class="text-muted mb-4">Update your public details or change your password.</p>

        <%= render "shared/error_messages", object: @user %>

        <%= form_with model: @user, local: true do |f| %>
          <fieldset class="border-0 p-0 mb-4">
            <legend class="h6 fw-bold mb-3">Public profile</legend>

            <div class="mb-3">
              <%= f.label :name, class: "form-label" do %>
                Full name <span class="smb-required" aria-hidden="true">*</span>
              <% end %>
              <%= f.text_field :name, { class: "form-control", autocomplete: "name" }.merge(field_a11y_attrs(@user, :name, required: true)) %>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-sm-6">
                <%= f.label :city, "City", class: "form-label" %>
                <%= f.text_field :city, { class: "form-control", autocomplete: "address-level2" }.merge(field_a11y_attrs(@user, :city)) %>
              </div>
              <div class="col-sm-6">
                <%= f.label :country, "Country", class: "form-label" %>
                <%= f.text_field :country, { class: "form-control", autocomplete: "country-name" }.merge(field_a11y_attrs(@user, :country)) %>
              </div>
            </div>

            <div class="mb-0">
              <%= f.label :bio, "About you", class: "form-label" %>
              <%= f.text_area :bio, { class: "form-control", rows: 3, placeholder: "e.g. Frequent traveler between London and Dakar." }.merge(field_a11y_attrs(@user, :bio)) %>
            </div>
          </fieldset>

          <hr class="my-4">

          <fieldset class="border-0 p-0 mb-4">
            <legend class="h6 fw-bold mb-3 text-muted">Change password (optional)</legend>

            <div class="row g-3">
              <div class="col-sm-6">
                <%= f.label :password, "New password", class: "form-label" %>
                <%= f.password_field :password, { class: "form-control", autocomplete: "new-password" }.merge(field_a11y_attrs(@user, :password)) %>
              </div>
              <div class="col-sm-6">
                <%= f.label :password_confirmation, "Confirm new password", class: "form-label" %>
                <%= f.password_field :password_confirmation, { class: "form-control", autocomplete: "new-password" }.merge(field_a11y_attrs(@user, :password_confirmation)) %>
              </div>
            </div>
          </fieldset>

          <div class="d-flex gap-2">
            <%= f.submit "Save changes", class: "btn btn-primary px-4" %>
            <%= link_to "Cancel", user_path(@user), class: "btn btn-outline-secondary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
