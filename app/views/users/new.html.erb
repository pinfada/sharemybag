<% provide(:title, "Create an account") %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="smb-card p-4 p-md-5">
        <div class="mb-4">
          <h1 class="h3 mb-1">Create an account</h1>
          <p class="text-muted mb-0">Post a parcel or submit offers on routes you already travel.</p>
        </div>

        <p class="small text-muted mb-3">Fields marked with <span class="smb-required" aria-hidden="true">*</span><span class="visually-hidden">an asterisk</span> are required.</p>

        <%= render "shared/error_messages", object: @user %>

        <%= form_with model: @user, local: true do |f| %>
          <div class="mb-3">
            <%= f.label :name, class: "form-label" do %>
              Full name <span class="smb-required" aria-hidden="true">*</span>
            <% end %>
            <%= f.text_field :name, { class: "form-control", placeholder: "e.g. Aminata Diallo", autocomplete: "name" }.merge(field_a11y_attrs(@user, :name, required: true)) %>
          </div>

          <div class="mb-3">
            <%= f.label :email, class: "form-label" do %>
              Email address <span class="smb-required" aria-hidden="true">*</span>
            <% end %>
            <%= f.email_field :email, { class: "form-control", placeholder: "you@example.com", autocomplete: "email" }.merge(field_a11y_attrs(@user, :email, required: true, describedby: "signup-email-hint")) %>
            <div id="signup-email-hint" class="form-text">Your email stays private and is never shown on your public profile.</div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-sm-6">
              <%= f.label :city, "City", class: "form-label" %>
              <%= f.text_field :city, { class: "form-control", placeholder: "e.g. London", autocomplete: "address-level2" }.merge(field_a11y_attrs(@user, :city)) %>
            </div>
            <div class="col-sm-6">
              <%= f.label :country, "Country", class: "form-label" %>
              <%= f.text_field :country, { class: "form-control", placeholder: "e.g. United Kingdom", autocomplete: "country-name" }.merge(field_a11y_attrs(@user, :country)) %>
            </div>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-sm-6">
              <%= f.label :password, class: "form-label" do %>
                Password <span class="smb-required" aria-hidden="true">*</span>
              <% end %>
              <%= f.password_field :password, { class: "form-control", autocomplete: "new-password" }.merge(field_a11y_attrs(@user, :password, required: true, describedby: "signup-password-hint")) %>
            </div>
            <div class="col-sm-6">
              <%= f.label :password_confirmation, class: "form-label" do %>
                Confirm password <span class="smb-required" aria-hidden="true">*</span>
              <% end %>
              <%= f.password_field :password_confirmation, { class: "form-control", autocomplete: "new-password" }.merge(field_a11y_attrs(@user, :password_confirmation, required: true)) %>
            </div>
            <div class="col-12 mt-1">
              <div id="signup-password-hint" class="form-text">Minimum 8 characters, including an uppercase letter, a lowercase letter, and a number.</div>
            </div>
          </div>

          <%= f.submit "Create account", class: "btn btn-primary w-100 py-2" %>
        <% end %>

        <hr class="my-4">

        <p class="text-center text-muted small mb-0">
          Already have an account?
          <%= link_to "Sign in", signin_path, class: "fw-semibold" %>
        </p>
      </div>
    </div>
  </div>
</div>