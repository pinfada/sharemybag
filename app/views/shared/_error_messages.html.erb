<% if object && object.errors.any? %>
  <div class="alert alert-danger border-0 shadow-sm mb-4" role="alert" tabindex="-1" data-error-summary>
    <h2 class="h6 fw-bold mb-2">
      <i class="fas fa-exclamation-circle me-1" aria-hidden="true"></i>
      Please fix <%= pluralize(object.errors.count, "error") %> before continuing:
    </h2>
    <ul class="mb-0 ps-3 small">
      <% object.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>