<% provide(:title, "Conversation with #{@other_user.name}") %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="mb-3">
        <%= link_to "← All messages", conversations_path, class: "small" %>
      </div>

      <div class="smb-card p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-3 mb-3 border-bottom">
          <div class="d-flex align-items-center gap-2">
            <%= user_avatar(@other_user, size: :md) %>
            <div>
              <h1 class="h5 mb-0"><%= link_to @other_user.name, user_path(@other_user), class: "text-dark" %></h1>
              <% if @conversation.shipping_request %>
                <div class="small text-muted">
                  Regarding: <%= link_to @conversation.shipping_request.title, shipping_request_path(@conversation.shipping_request) %>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <ul class="smb-message-list mb-3" aria-label="Message history">
          <% if @messages.any? %>
            <% @messages.each do |msg| %>
              <% mine = msg.sender_id == current_user.id %>
              <li class="smb-bubble <%= mine ? 'smb-bubble--mine' : 'smb-bubble--theirs' %>">
                <span class="visually-hidden"><%= mine ? "You wrote:" : "#{msg.sender.name} wrote:" %></span>
                <div><%= msg.body %></div>
                <div class="small mt-1 smb-bubble-time">
                  <%= l(msg.created_at, format: :short) %>
                </div>
              </li>
            <% end %>
          <% else %>
            <li class="text-muted text-center my-4">Start the conversation to coordinate handover details.</li>
          <% end %>
        </ul>

        <%= form_with model: [@conversation, @message], local: true, class: "d-flex gap-2" do |f| %>
          <%= f.label :body, "Write a message", class: "visually-hidden" %>
          <%= f.text_field :body, class: "form-control", placeholder: "Write your message...", required: true, "aria-required": "true", maxlength: 2000, autocomplete: "off" %>
          <%= f.submit "Send", class: "btn btn-primary px-4" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
