<% provide(:title, "My offers") %>

<div class="container py-5">
  <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
      <h1 class="h2 mb-1">My transport offers</h1>
      <p class="text-muted mb-0">Track the rates you submitted and the parcels entrusted to you.</p>
    </div>
    <%= link_to "Browse open requests", shipping_requests_path, class: "btn btn-outline-primary" %>
  </div>

  <% if @bids.any? %>
    <ul class="d-flex flex-column gap-3 list-unstyled mb-0">
      <% @bids.each do |bid| %>
        <% req = bid.shipping_request %>
        <li class="smb-card p-4 <%= 'smb-card--highlight' if bid.status == 'accepted' %>">
          <div class="row align-items-center gy-3">
            <div class="col-md-6">
              <div class="d-flex align-items-center gap-2 mb-2">
                <span class="<%= status_badge_class(bid.status) %>"><%= t("statuses.#{bid.status}") %></span>
                <span class="small text-muted">Flight on <%= l(bid.travel_date, format: :short) %></span>
              </div>
              <h2 class="h5 mb-1">
                <%= link_to req.title, shipping_request_path(req), class: "text-dark" %>
              </h2>
              <div class="small text-muted">
                <%= req.departure_city %> to <%= req.arrival_city %> · <%= number_with_precision(req.weight_kg, strip_insignificant_zeros: true) %> kg · Sender: <%= req.sender.name %>
              </div>
            </div>
            <div class="col-md-3">
              <div class="fw-bold text-dark fs-5"><%= format_euros(bid.total_price_cents) %></div>
              <div class="small text-muted"><%= format_euros(bid.price_per_kg_cents) %> / kg</div>
            </div>
            <div class="col-md-3 text-md-end d-flex flex-wrap gap-2 justify-content-md-end">
              <%= link_to "View request", shipping_request_path(req), class: "btn btn-outline-secondary btn-sm" %>
              <% if bid.status == "accepted" && req.shipment_tracking %>
                <%= link_to "Open tracking", shipment_tracking_path(req.shipment_tracking), class: "btn btn-success btn-sm" %>
              <% end %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>

    <nav aria-label="Pagination" class="mt-4">
      <%= will_paginate @bids, previous_label: "← Previous", next_label: "Next →" %>
    </nav>
  <% else %>
    <div class="smb-empty-state">
      <h2 class="h5 mb-2">You haven't submitted any offers yet</h2>
      <p class="text-muted mb-3">Browse open shipping requests along your upcoming trip and propose a price per kilo.</p>
      <%= link_to "Browse open requests", shipping_requests_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
