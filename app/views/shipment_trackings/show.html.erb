<% provide(:title, "Shipment tracking") %>

<div class="container py-5">
  <div class="mb-3">
    <%= link_to "← Back to shipping request", shipping_request_path(@shipping_request), class: "small" %>
  </div>

  <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
      <span class="<%= status_badge_class(@tracking.status) %> mb-2">
        <%= t("tracking.statuses.#{@tracking.status}") %>
      </span>
      <h1 class="h2 mb-1"><%= @shipping_request.title %></h1>
      <div class="smb-route">
        <span><%= @shipping_request.departure_city %></span>
        <i class="fas fa-arrow-right smb-route-arrow" aria-hidden="true"></i>
        <span class="visually-hidden">to</span>
        <span><%= @shipping_request.arrival_city %></span>
        <span class="smb-route-country">
          · <%= number_with_precision(@shipping_request.weight_kg, strip_insignificant_zeros: true) %> kg
          <% if @accepted_bid %>
            · <%= format_euros(@accepted_bid.total_price_cents) %>
          <% end %>
        </span>
      </div>
    </div>

    <div>
      <% counterpart = @is_sender ? @tracking.traveler : @shipping_request.sender %>
      <%= button_to "Message #{counterpart.name.split.first}",
          conversations_path(recipient_id: counterpart.id, shipping_request_id: @shipping_request.id),
          method: :post,
          class: "btn btn-outline-primary" %>
    </div>
  </div>

  <!-- 5-step accessible progress tracker -->
  <section class="smb-card p-4 mb-4" aria-labelledby="timeline-heading">
    <h2 id="timeline-heading" class="h6 text-muted mb-3">Delivery progress</h2>
    <ol class="smb-timeline">
      <% @timeline.each do |step| %>
        <li class="smb-step <%= 'is-current' if step[:current] %> <%= 'is-reached' if step[:reached] && !step[:current] %>"
            <%= 'aria-current="step"'.html_safe if step[:current] %>>
          <div class="smb-step-icon" aria-hidden="true">
            <% if step[:reached] %>
              <i class="fas fa-check"></i>
            <% else %>
              <i class="far fa-circle"></i>
            <% end %>
          </div>
          <div class="small fw-semibold text-dark">
            <%= t("tracking.statuses.#{step[:status]}") %>
            <span class="visually-hidden">
              (<%= step[:current] ? "current step" : (step[:reached] ? "completed" : "upcoming") %>)
            </span>
          </div>
          <% if step[:timestamp].present? %>
            <div class="small text-muted"><%= l(step[:timestamp], format: :short) %></div>
          <% end %>
        </li>
      <% end %>
    </ol>
  </section>

  <div class="row gy-4">
    <div class="col-lg-8">
      <section class="smb-card p-4" aria-labelledby="current-action-heading">
        <% case @tracking.status %>
        <% when "created" %>
          <% if @is_sender %>
            <h2 id="current-action-heading" class="h5 mb-2">Step 1: Hand over the parcel to your traveler</h2>
            <p class="text-muted mb-3">
              When meeting <strong><%= @tracking.traveler.name %></strong>, inspect the parcel together and share this confidential handover code.
            </p>
            <div class="smb-code-box mb-3">
              <div>
                <div class="smb-code-label">Handover code (confidential)</div>
                <div class="smb-code-value"><%= @tracking.handover_code %></div>
              </div>
              <button type="button" class="btn btn-outline-light btn-sm"
                      data-copy-code="<%= @tracking.handover_code %>"
                      data-copy-status-id="handover-copy-status">
                <i class="far fa-copy me-1" aria-hidden="true"></i>Copy code
              </button>
            </div>
            <div id="handover-copy-status" class="visually-hidden" role="status" aria-live="polite"></div>
            <p class="small text-muted mb-0">
              <i class="fas fa-lock me-1" aria-hidden="true"></i>
              Share this code only in person at the exact moment of parcel handover.
            </p>
          <% else %>
            <h2 id="current-action-heading" class="h5 mb-2">Verify open inspection &amp; parcel handover</h2>
            <p class="text-muted mb-3">
              For airport security compliance, never accept a sealed package. Open and visually check every item handed over by <strong><%= @shipping_request.sender.name %></strong>, pack it into your own luggage, then enter the 8-character handover code.
            </p>
            <%= form_with url: hand_over_shipment_tracking_path(@tracking), method: :post, local: true do %>
              <div class="form-check mb-3 p-3 rounded border bg-light ps-5">
                <%= check_box_tag :open_inspection_confirmed, "1", false, class: "form-check-input", required: true, "aria-required": "true" %>
                <%= label_tag :open_inspection_confirmed, class: "form-check-label small fw-semibold text-dark" do %>
                  I opened and visually inspected all items against the request description, verified there are no prohibited or dangerous goods, and packed them myself. <span class="smb-required" aria-hidden="true">*</span>
                <% end %>
              </div>
              <div class="row g-2 align-items-end">
                <div class="col-sm-7">
                  <%= label_tag :code, class: "form-label" do %>
                    Handover code <span class="smb-required" aria-hidden="true">*</span>
                  <% end %>
                  <%= text_field_tag :code, nil, class: "form-control text-uppercase", placeholder: "e.g. A7K9P2XM", maxlength: 8, required: true, "aria-required": "true", autocomplete: "off" %>
                </div>
                <div class="col-sm-5">
                  <%= submit_tag "Verify handover", class: "btn btn-primary w-100" %>
                </div>
              </div>
            <% end %>
          <% end %>

        <% when "handed_over" %>
          <% if @is_traveler %>
            <h2 id="current-action-heading" class="h5 mb-2">Step 2: Start transit</h2>
            <p class="text-muted mb-3">
              The parcel is in your custody. Mark it in transit when departing for <strong><%= @shipping_request.arrival_city %></strong>.
            </p>
            <%= button_to "Mark parcel in transit", mark_in_transit_shipment_tracking_path(@tracking), method: :post, class: "btn btn-primary" %>
          <% else %>
            <h2 id="current-action-heading" class="h5 mb-2">Parcel handed over</h2>
            <p class="text-muted mb-0">
              <strong><%= @tracking.traveler.name %></strong> has verified parcel pickup. You will be notified once it is marked in transit.
            </p>
          <% end %>

        <% when "in_transit" %>
          <% if @is_sender %>
            <h2 id="current-action-heading" class="h5 mb-2">Step 3: Parcel in transit to <%= @shipping_request.arrival_city %></h2>
            <p class="text-muted mb-3">
              Keep this delivery code safe. Share it with your recipient (or the traveler upon final delivery only) to verify delivery completion.
            </p>
            <div class="smb-code-box mb-3">
              <div>
                <div class="smb-code-label">Delivery code (confidential)</div>
                <div class="smb-code-value"><%= @tracking.delivery_code %></div>
              </div>
              <button type="button" class="btn btn-outline-light btn-sm"
                      data-copy-code="<%= @tracking.delivery_code %>"
                      data-copy-status-id="delivery-copy-status">
                <i class="far fa-copy me-1" aria-hidden="true"></i>Copy code
              </button>
            </div>
            <div id="delivery-copy-status" class="visually-hidden" role="status" aria-live="polite"></div>
            <p class="small text-muted mb-0">
              <i class="fas fa-lock me-1" aria-hidden="true"></i>
              This code is never displayed to the traveler until you choose to share it.
            </p>
          <% else %>
            <h2 id="current-action-heading" class="h5 mb-2">Verify delivery at destination</h2>
            <p class="text-muted mb-3">
              When delivering the parcel at destination, request the 8-character delivery code and submit it below.
            </p>
            <%= form_with url: deliver_shipment_tracking_path(@tracking), method: :post, local: true, class: "row g-2 align-items-end" do %>
              <div class="col-sm-7">
                <%= label_tag :code, class: "form-label" do %>
                  Delivery code <span class="smb-required" aria-hidden="true">*</span>
                <% end %>
                <%= text_field_tag :code, nil, class: "form-control text-uppercase", placeholder: "e.g. X4M8Q2VN", maxlength: 8, required: true, "aria-required": "true", autocomplete: "off" %>
              </div>
              <div class="col-sm-5">
                <%= submit_tag "Verify delivery", class: "btn btn-success w-100" %>
              </div>
            <% end %>
          <% end %>

        <% when "delivered" %>
          <% if @is_sender %>
            <h2 id="current-action-heading" class="h5 mb-2">Step 4: Confirm final receipt</h2>
            <p class="text-muted mb-3">
              The traveler verified delivery with your code. Confirm receipt to close this shipment and unlock mutual reviews.
            </p>
            <%= button_to "Confirm parcel receipt",
                confirm_shipment_tracking_path(@tracking),
                method: :post,
                class: "btn btn-success btn-lg",
                form: { data: { confirm_message: "Confirm that the parcel has been safely received?" } } %>
          <% else %>
            <h2 id="current-action-heading" class="h5 mb-2">Delivery verified</h2>
            <p class="text-muted mb-0">
              Waiting for final confirmation from <strong><%= @shipping_request.sender.name %></strong>.
            </p>
          <% end %>

        <% when "confirmed" %>
          <h2 id="current-action-heading" class="h5 text-success mb-2">
            <i class="fas fa-check-circle me-1" aria-hidden="true"></i>
            Shipment delivered and confirmed
          </h2>
          <p class="text-muted mb-4">
            Thank you for using ShareMyBag. Your review helps other members choose trusted partners.
          </p>

          <% if @already_reviewed %>
            <div class="alert alert-light border mb-0 small" role="status">
              <i class="fas fa-star smb-star-filled me-1" aria-hidden="true"></i>
              You have already submitted your review for this shipment.
            </div>
          <% else %>
            <div class="border-top pt-4">
              <h3 class="h5 mb-3">
                Rate <%= @is_sender ? @tracking.traveler.name : @shipping_request.sender.name %>
              </h3>
              <%= form_with model: [@shipping_request, @review], local: true do |f| %>
                <div class="mb-3">
                  <%= f.label :rating, class: "form-label" do %>
                    Rating (out of 5) <span class="smb-required" aria-hidden="true">*</span>
                  <% end %>
                  <%= f.select :rating,
                      [["5 — Excellent", 5], ["4 — Very good", 4], ["3 — Good", 3], ["2 — Fair", 2], ["1 — Poor", 1]],
                      {}, class: "form-select", required: true, "aria-required": "true" %>
                </div>
                <div class="mb-3">
                  <%= f.label :comment, "Your feedback", class: "form-label" %>
                  <%= f.text_area :comment, class: "form-control", rows: 3, placeholder: "Punctuality, communication, parcel care..." %>
                </div>
                <%= f.submit "Publish review", class: "btn btn-primary" %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </section>
    </div>

    <aside class="col-lg-4" aria-label="Shipment participants">
      <div class="smb-card p-4">
        <h2 class="h6 text-muted mb-3">Participants</h2>
        <div class="d-flex align-items-center gap-2 mb-3">
          <%= user_avatar(@shipping_request.sender, size: :sm) %>
          <div>
            <div class="small text-muted">Sender</div>
            <div class="fw-semibold"><%= link_to @shipping_request.sender.name, user_path(@shipping_request.sender), class: "text-dark" %></div>
          </div>
        </div>
        <div class="d-flex align-items-center gap-2">
          <%= user_avatar(@tracking.traveler, size: :sm) %>
          <div>
            <div class="small text-muted">Traveler</div>
            <div class="fw-semibold"><%= link_to @tracking.traveler.name, user_path(@tracking.traveler), class: "text-dark" %></div>
          </div>
        </div>
      </div>
    </aside>
  </div>
</div>
